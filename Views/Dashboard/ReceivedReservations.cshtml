@model IEnumerable<CovStudent.Models.Reservation>

@{
    ViewData["Title"] = "Demandes recues";
    var reservations = Model ?? Enumerable.Empty<CovStudent.Models.Reservation>();

    string Badge(ReservationStatus status) => status switch
    {
        ReservationStatus.Pending => "badge-pending",
        ReservationStatus.Confirmed => "badge-confirmed",
        ReservationStatus.Cancelled => "badge-cancelled",
        ReservationStatus.Completed => "badge-completed",
        _ => "badge-default"
    };
}

<div class="container py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="received-reservations-header">
        <div>
            <span class="eyebrow"><i class="fas fa-car me-1"></i>Conducteur</span>
            <h1 class="page-title mb-0">Demandes de reservation</h1>
        </div>
        <a asp-controller="Trip" asp-action="Create" class="btn btn-dark btn-sm">
            <i class="fas fa-plus me-2"></i>Publier un trajet
        </a>
    </div>

    @if (!reservations.Any())
    {
        <section class="app-card empty-state">
            <i class="fas fa-inbox"></i>
            <h2>Aucune demande</h2>
            <p>Les demandes des passagers apparaitront ici.</p>
        </section>
    }
    else
    {
        <section class="app-card p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0 app-table">
                    <thead>
                        <tr>
                            <th><i class="fas fa-user me-2"></i>Passager</th>
                            <th><i class="fas fa-route me-2"></i>Trajet</th>
                            <th><i class="fas fa-clock me-2"></i>Date demande</th>
                            <th><i class="fas fa-chair me-2"></i>Places</th>
                            <th><i class="fas fa-tag me-2"></i>Total</th>
                            <th><i class="fas fa-info me-2"></i>Statut</th>
                            <th class="text-end"><i class="fas fa-cogs me-2"></i>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reservation in reservations)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        <span class="passenger-info">@(reservation.Passenger?.FullName ?? "Passager")</span>
                                        @if (reservation.Passenger != null)
                                        {
                                            <a asp-controller="Account"
                                               asp-action="Profile"
                                               asp-route-id="@reservation.PassengerId"
                                               asp-route-tripId="@reservation.TripId"
                                               class="btn btn-sm btn-outline-dark align-self-start">
                                                <i class="fas fa-user me-1"></i>Voir profil
                                            </a>
                                        }
                                        <span class="passenger-email">@reservation.Passenger?.Email</span>
                                        <span class="passenger-email">
                                        @(string.IsNullOrWhiteSpace(reservation.Passenger?.City) && string.IsNullOrWhiteSpace(reservation.Passenger?.Address)
                                            ? "Localisation non renseignée"
                                            : string.Join(" - ", new[] { reservation.Passenger?.City, reservation.Passenger?.Address }.Where(value => !string.IsNullOrWhiteSpace(value))))
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <span class="trip-route">@reservation.Trip?.Departure → @reservation.Trip?.Destination</span>
                                    <span class="trip-date-info">@(reservation.Trip?.DepartureTime.ToString("dd/MM/yyyy HH:mm") ?? "-")</span>
                                </td>
                                <td>@reservation.ReservationDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><span class="badge" style="background: #e7f5f5; color: #136f63;">@reservation.NumberOfSeats</span></td>
                                <td style="font-weight: 700; color: #d99a2b;">@reservation.TotalPrice.ToString("0.00") TND</td>
                                <td><span class="badge @Badge(reservation.Status)">@reservation.Status</span></td>
                                <td class="text-end">
                                    <div class="btn-actions">
                                        @if (reservation.Trip != null)
                                        {
                                            <a asp-controller="Trip" asp-action="Details" asp-route-id="@reservation.TripId" class="btn btn-outline-dark" title="Voir détails">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        }
                                        @if (reservation.Passenger != null)
                                        {
                                            <a asp-controller="Message" asp-action="Index" asp-route-userId="@reservation.PassengerId" asp-route-tripId="@reservation.TripId" class="btn btn-outline-dark" title="Messagerie">
                                                <i class="fas fa-envelope"></i>
                                            </a>
                                        }
                                        @if (reservation.Status == ReservationStatus.Pending)
                                        {
                                            <form asp-controller="Reservation" asp-action="Confirm" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@reservation.Id" />
                                                <button class="btn btn-success" style="padding: 6px 10px; font-size: 12px; border-radius: 6px;" title="Confirmer">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            </form>
                                            <form asp-controller="Reservation" asp-action="Cancel" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@reservation.Id" />
                                                <button class="btn btn-outline-danger" style="padding: 6px 10px; font-size: 12px; border-radius: 6px;" title="Refuser">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>
