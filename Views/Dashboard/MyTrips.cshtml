@using CovStudent.Models
@model IEnumerable<Trip>

@{
    ViewData["Title"] = "Mes trajets";
}

<div class="container py-4">
    <div class="mytrips-header">
        <div>
            <span class="eyebrow"><i class="fas fa-car-side"></i> Gestion conducteur</span>
            <h1 class="page-title mb-0">Mes trajets publiés</h1>
        </div>

        <a asp-controller="Trip" asp-action="Create" class="btn btn-dark btn-sm">
            <i class="fas fa-plus me-2"></i>Publier un trajet
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card-modern empty-state">
            <i class="fas fa-car"></i>

            <h5>Aucun trajet publié</h5>
            <p>Commencez à publier votre premier trajet.</p>

            <a asp-controller="Trip" asp-action="Create" class="btn btn-dark">
                <i class="fas fa-plus me-2"></i>Publier mon premier trajet
            </a>
        </div>
    }
    else
    {
        <div class="card-modern p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4"><i class="fas fa-arrow-right me-2"></i>Départ</th>
                            <th><i class="fas fa-location-dot me-2"></i>Destination</th>
                            <th><i class="fas fa-calendar me-2"></i>Date</th>
                            <th><i class="fas fa-chair me-2"></i>Places</th>
                            <th><i class="fas fa-tag me-2"></i>Prix</th>
                            <th><i class="fas fa-info me-2"></i>Statut</th>
                            <th class="pe-4 text-end"><i class="fas fa-cogs me-2"></i>Actions</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var trip in Model)
                        {
                            var bookedSeats = trip.Reservations?.Where(r => r.Status != ReservationStatus.Cancelled).Sum(r => r.NumberOfSeats) ?? 0;
                            var remainingSeats = Math.Max(0, trip.AvailableSeats - bookedSeats);

                            <tr>

                                <td class="ps-4">
                                    <div class="trip-route">@trip.Departure</div>
                                </td>

                                <td>
                                    <div class="trip-route">@trip.Destination</div>
                                </td>

                                <td>
                                    <div class="trip-date">@trip.DepartureTime.ToString("dd/MM/yyyy")</div>
                                    <div class="trip-date-time">@trip.DepartureTime.ToString("HH:mm")</div>
                                </td>

                                <td>
                                    <div class="seats-badge">@remainingSeats / @trip.AvailableSeats</div>
                                    <div class="seats-info">@bookedSeats réservée(s)</div>
                                </td>

                                <td class="price-display">
                                    @trip.PricePerSeat.ToString("0.00") TND
                                </td>

                                <td>
                                    @switch (trip.Status)
                                    {
                                        case TripStatus.Active:
                                            <span class="badge badge-soft" style="background: #e7f5f5; color: #136f63;">
                                                <i class="fas fa-check-circle me-1"></i>Actif
                                            </span>
                                            break;

                                        case TripStatus.Completed:
                                            <span class="badge badge-soft" style="background: #e7f5f5; color: #228b5f;">
                                                <i class="fas fa-flag-checkered me-1"></i>Terminé
                                            </span>
                                            break;

                                        case TripStatus.Cancelled:
                                            <span class="badge badge-soft" style="background: #ffe5e5; color: #b9473c;">
                                                <i class="fas fa-times-circle me-1"></i>Annulé
                                            </span>
                                            break;

                                        default:
                                            <span class="badge badge-soft" style="background: #f0f0f0; color: #68706a;">
                                                @trip.Status
                                            </span>
                                            break;
                                    }
                                </td>

                                <td class="pe-4">
                                    <div class="btn-actions">
                                        <a asp-controller="Trip" asp-action="Details" asp-route-id="@trip.Id" 
                                           class="btn btn-outline-dark" title="Voir détails">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-controller="Trip" asp-action="Edit" asp-route-id="@trip.Id" 
                                           class="btn btn-outline-dark" title="Modifier">
                                            <i class="fas fa-pencil"></i>
                                        </a>
                                        <a asp-controller="Trip" asp-action="Delete" asp-route-id="@trip.Id" 
                                           class="btn btn-outline-danger" title="Supprimer">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                        @if (trip.Status == TripStatus.Active && trip.DepartureTime <= DateTime.Now)
                                        {
                                            <form asp-controller="Trip" asp-action="Complete" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@trip.Id" />
                                                <button class="btn btn-sm btn-success" title="Marquer comme terminé" style="padding: 6px 10px; font-size: 12px;">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>
                </table>
            </div>
        </div>
    }

</div>
