@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject CovStudent.Data.ApplicationDbContext DbContext

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isAuthPage = controller == "Account" && (action == "Login" || action == "Register");
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var displayName = User.Identity?.Name ?? "Mon compte";
    var unreadNotifications = 0;
    var unreadMessages = 0;

    if (isAuthenticated && !string.IsNullOrEmpty(currentUserId))
    {
        unreadNotifications = await DbContext.Notifications
            .CountAsync(n => n.RecipientId == currentUserId && !n.IsRead);

        unreadMessages = await DbContext.Messages
            .CountAsync(m => m.ReceiverId == currentUserId && !m.IsRead);
    }

    string Active(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
}

<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - CovStudent</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body class="@(isAuthPage ? "auth-layout" : "app-layout")">
    <header class="app-navbar @(isAuthPage ? "app-navbar-auth" : string.Empty)">
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid">
                <a class="navbar-brand app-brand" asp-controller="@(isAuthenticated ? "Dashboard" : "Trip")" asp-action="Index">
                    <span class="brand-mark"><i class="fas fa-route"></i></span>
                    <span class="brand-text">CovStudent</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavigation">
                    @if (isAuthenticated)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link @(Active("Dashboard"))" asp-controller="Dashboard" asp-action="Index">
                                    <i class="fas fa-gauge-high"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(Active("Trip"))" asp-controller="Trip" asp-action="Index">
                                    <i class="fas fa-map-location-dot"></i> Trajets
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Trip" asp-action="Create">
                                    <i class="fas fa-plus"></i> Publier
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(Active("Message"))" asp-controller="Message" asp-action="Conversations">
                                    <i class="fas fa-comments"></i> Messages
                                    @if (unreadMessages > 0)
                                    {
                                        <span class="nav-count">@unreadMessages</span>
                                    }
                                </a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(Active("Admin"))" asp-controller="Admin" asp-action="Dashboard">
                                        <i class="fas fa-shield-halved"></i> Admin
                                    </a>
                                </li>
                            }
                        </ul>

                        <div class="d-flex align-items-center gap-2 nav-actions">
                            <a class="icon-link-btn" asp-controller="Notifications" asp-action="Index" aria-label="Notifications">
                                <i class="fas fa-bell"></i>
                                @if (unreadNotifications > 0)
                                {
                                    <span class="icon-badge">@unreadNotifications</span>
                                }
                            </a>

                            <a class="account-chip" asp-controller="Account" asp-action="Profile" title="Profil">
                                <span class="account-avatar"><i class="fas fa-user"></i></span>
                                <span class="account-name">@displayName</span>
                            </a>

                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button class="btn btn-dark btn-sm" type="submit" title="Déconnexion">
                                    <i class="fas fa-right-from-bracket"></i>
                                    <span>Déconnexion</span>
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link @(Active("Trip"))" asp-controller="Trip" asp-action="Index">
                                    <i class="fas fa-map-location-dot"></i> Trajets
                                </a>
                            </li>
                        </ul>

                        <div class="d-flex align-items-center gap-2 nav-actions">
                            <a class="btn btn-outline-dark btn-sm" asp-controller="Account" asp-action="Login">
                                <i class="fas fa-right-to-bracket"></i> Connexion
                            </a>
                            <a class="btn btn-dark btn-sm" asp-controller="Account" asp-action="Register">
                                <i class="fas fa-user-plus"></i> Inscription
                            </a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main class="app-main @(isAuthPage ? "auth-main" : string.Empty)">
        @RenderBody()
    </main>

    @if (isAuthenticated)
    {
        <div class="notification-toast" id="notificationToast" hidden>
            <strong id="notificationToastTitle"></strong>
            <span id="notificationToastBody"></span>
        </div>
    }

    @if (!isAuthPage)
    {
        <footer class="app-footer">
            <div class="container-fluid d-flex justify-content-between gap-2 flex-wrap">
                <span>CovStudent</span>
                <span>Trajets, réservations, messages et notifications.</span>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @if (isAuthenticated)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
