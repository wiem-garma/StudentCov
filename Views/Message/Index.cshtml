@model IEnumerable<CovStudent.Models.Message>

@{
    ViewData["Title"] = "Conversation";
    var withUser = ViewBag.WithUser as CovStudent.Models.AppUser;
    var trip = ViewBag.Trip as CovStudent.Models.Trip;
}

<style>
    .chat-card {
        border-radius: 16px;
        overflow: hidden;
        border: none;
        box-shadow: 0 10px 35px rgba(0,0,0,0.08);
        background: white;
        display: flex;
        flex-direction: column;
        height: calc(100vh - 120px);
    }

    .chat-header {
        background: linear-gradient(135deg, #136f63, #0d5148);
        color: white;
        padding: 16px 20px;
        border-bottom: none;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .chat-header-content {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .chat-header-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(255,255,255,0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #d99a2b;
        font-weight: bold;
        font-size: 14px;
    }

    .chat-header-info {
        display: flex;
        flex-direction: column;
    }

    .chat-header-name {
        font-weight: 700;
        font-size: 15px;
    }

    .chat-header-status {
        font-size: 11px;
        opacity: 0.8;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        background: #f8f9fa;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .message-group {
        width: 100%;
        margin-bottom: 12px;
    }

    .message-group > div {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .message-group.sent > div {
        margin-left: auto;
        align-items: flex-end;
    }

    .message-group.received > div {
        margin-right: auto;
        align-items: flex-start;
    }

    .message-bubble {
        width: fit-content;
        max-width: 100%;
        padding: 12px 16px;
        border-radius: 14px;
        font-size: 14px;
        line-height: 1.5;
        white-space: pre-wrap;
        overflow-wrap: break-word;
        word-break: normal;
    }

    .message-group.sent .message-bubble {
        background: linear-gradient(135deg, #136f63, #0d5148);
        color: white;
        border-bottom-right-radius: 4px;
    }

    .message-group.sent .message-time {
        text-align: right;
    }

    .message-group.received .message-bubble {
        background: white;
        border: 1px solid #e5e5e5;
        color: #202124;
        border-bottom-left-radius: 4px;
    }

    .message-time {
        font-size: 11px;
        color: #68706a;
        margin-top: 4px;
        padding: 0 12px;
    }

    .chat-footer {
        padding: 16px 20px;
        background: white;
        border-top: 1px solid #e5e5e5;
        display: flex;
        gap: 12px;
    }

    .message-input {
        flex: 1;
        border-radius: 10px;
        border: 1.5px solid #e5e5e5;
        padding: 10px 14px;
        font-size: 14px;
        transition: 0.2s ease;
    }

    .message-input:focus {
        border-color: #136f63;
        box-shadow: 0 0 0 3px rgba(19,111,99,0.1);
        outline: none;
    }

    .btn-send {
        background: linear-gradient(135deg, #136f63, #0d5148);
        color: white;
        border: none;
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.2s ease;
        font-size: 14px;
    }

    .btn-send:hover {
        background: #0d5148;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(13,81,72,0.2);
    }

    .back-button {
        background: rgba(255,255,255,0.2);
        color: white;
        border: none;
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.2s ease;
    }

    .back-button:hover {
        background: rgba(255,255,255,0.3);
    }

    .empty-messages {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: #68706a;
    }

    .empty-messages i {
        font-size: 48px;
        opacity: 0.3;
        margin-bottom: 12px;
    }

    .chat-messages::-webkit-scrollbar {
        width: 6px;
    }

    .chat-messages::-webkit-scrollbar-track {
        background: transparent;
    }

    .chat-messages::-webkit-scrollbar-thumb {
        background: #d1d1d1;
        border-radius: 3px;
    }

    .chat-messages::-webkit-scrollbar-thumb:hover {
        background: #999;
    }

    @@media (max-width: 768px) {
        .chat-card {
            height: calc(100vh - 80px);
        }

        .message-bubble {
            max-width: 85%;
        }

        .chat-header-name {
            font-size: 14px;
        }

        .chat-messages {
            padding: 15px;
        }
    }
</style>

<div class="container py-4">

    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-danger mb-3">@errorMessage</div>
    }

    <div class="row justify-content-center">

        <div class="col-md-10">

            <div class="card chat-card">

                <!-- HEADER -->
                <div class="chat-header">
                    <div class="chat-header-content">
                        <div class="chat-header-avatar">
                            @{
                                var initial = !string.IsNullOrEmpty(withUser?.FullName)
                                    ? withUser.FullName.Substring(0, 1).ToUpper()
                                    : "U";
                            }
                            @initial
                        </div>
                        <div class="chat-header-info">
                            <div class="chat-header-name">@(withUser?.FullName ?? "Choisissez une conversation")</div>
                            <div class="chat-header-status">@(withUser != null ? "En ligne" : "Sélectionnez un destinataire")</div>
                            @if (trip != null)
                            {
                                <div class="chat-header-status">@trip.Departure → @trip.Destination</div>
                            }
                        </div>
                    </div>
                    <a href="@Url.Action("Conversations", "Message")" class="back-button" title="Retour">
                        <i class="fas fa-arrow-left"></i>
                    </a>
                </div>

                <!-- MESSAGES -->
                <div class="chat-messages" id="chatBox">

                    @if (withUser == null)
                    {
                        <div class="empty-messages">
                            <i class="fas fa-comments"></i>
                            <p>Sélectionnez une conversation pour commencer.</p>
                        </div>
                    }
                    else if (!Model.Any())
                    {
                        <div class="empty-messages">
                            <i class="fas fa-comments"></i>
                            <p>Commencez la conversation</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var msg in Model)
                        {
                            var isMine = msg.SenderId == ViewBag.CurrentUserId;

                            <div class="message-group @(isMine ? "sent" : "received")">
                                <div>
                                    <div class="message-bubble">@msg.Content</div>
                                    <div class="message-time">@msg.SentAt.ToString("HH:mm")</div>
                                </div>
                            </div>
                        }
                    }

                </div>

                <!-- INPUT -->
                <div class="chat-footer">

                    @if (withUser != null)
                    {
                        <form asp-action="Send" method="post" class="d-flex gap-2 w-100">

                            <input type="hidden" name="receiverId" value="@ViewBag.WithUser?.Id" />
                            <input type="hidden" name="tripId" value="@ViewBag.TripId" />

                            <input type="text"
                                   name="content"
                                   class="message-input"
                                   placeholder="Ecrire un message..."
                                   required
                                   autocomplete="off" />

                            <button type="submit" class="btn-send" title="Envoyer">
                                <i class="fas fa-paper-plane"></i>
                            </button>

                        </form>
                    }
                    else
                    {
                        <div class="text-muted small w-100 text-center py-2">Ouvrez une conversation depuis la liste des messages.</div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>

<script>
    // Auto scroll bottom
    const box = document.getElementById("chatBox");
    if (box) {
        box.scrollTop = box.scrollHeight;
    }
</script>