@model CovStudent.ViewModels.EditProfileViewModel

@{
    ViewData["Title"] = "Modifier mon profil";
}

<style>
    .auth-card {
        border-radius: 16px;
        overflow: hidden;
        border: none;
        box-shadow: 0 10px 35px rgba(0,0,0,0.08);
    }

    .auth-header {
        background: linear-gradient(135deg, #136f63, #0d5148);
        color: white;
        padding: 40px 20px;
        text-align: center;
    }

    .avatar-circle {
        width: 85px;
        height: 85px;
        background: rgba(255,255,255,0.15);
        color: #d99a2b;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        margin: 0 auto 15px auto;
        box-shadow: 0 8px 20px rgba(0,0,0,0.2);
    }

    .auth-header h4 {
        font-size: 20px;
        font-weight: 700;
        margin: 0 0 8px 0;
    }

    .auth-header p {
        font-size: 13px;
        color: rgba(255,255,255,0.8);
        margin: 0;
    }

    .form-modern {
        border-radius: 10px;
        padding: 12px 14px;
        border: 1.5px solid #e5e5e5;
        transition: 0.2s ease;
        font-size: 14px;
    }

    .form-modern:focus {
        border-color: #136f63;
        box-shadow: 0 0 0 3px rgba(19,111,99,0.1);
        outline: none;
    }

    .form-label {
        font-weight: 600;
        font-size: 13px;
        color: #202124;
        margin-bottom: 6px;
    }

    .form-label i {
        color: #d99a2b;
    }

    .btn-modern {
        background: linear-gradient(135deg, #136f63, #0d5148);
        color: white;
        border-radius: 8px;
        padding: 11px 18px;
        border: none;
        transition: 0.2s ease;
        font-weight: 600;
    }

    .btn-modern:hover {
        background: linear-gradient(135deg, #0d5148, #072a24);
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(19,111,99,0.25);
        color: white;
    }

    .btn-outline-modern {
        border-radius: 8px;
        border: 1.5px solid #136f63;
        background: transparent;
        padding: 11px 18px;
        transition: 0.2s ease;
        font-weight: 600;
        color: #136f63;
    }

    .btn-outline-modern:hover {
        background: #136f63;
        color: white;
    }

    .alert {
        border-radius: 8px;
        border: none;
    }

    .alert-success {
        background: #d4edda;
        color: #155724;
    }

    .alert-danger {
        background: #f8d7da;
        color: #721c24;
    }

    .text-danger {
        color: #b9473c !important;
    }

    .card-body {
        padding: 30px;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <!-- CARD -->
            <div class="card shadow-lg auth-card">

                <!-- HEADER -->
                <div class="auth-header">
                    <div class="avatar-circle">
                        <i class="fas fa-user-edit"></i>
                    </div>
                    <h4 class="fw-bold">Modifier mon profil</h4>
                    <p class="mb-0 opacity-75">Mettre à jour vos informations personnelles</p>
                </div>

                <!-- BODY -->
                <div class="card-body p-4 p-md-5">

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success rounded-3">
                            <i class="fas fa-check-circle me-2"></i>
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    <form asp-action="EditProfile" method="post">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>

                        <!-- NOM + PRENOM -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label">
                                    <i class="fas fa-user text-gold me-1"></i> Nom
                                </label>
                                <input asp-for="LastName" class="form-control form-modern" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label">
                                    <i class="fas fa-user text-gold me-1"></i> Prénom
                                </label>
                                <input asp-for="FirstName" class="form-control form-modern" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- EMAIL -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">
                                <i class="fas fa-envelope text-gold me-1"></i> Email
                            </label>
                            <input asp-for="Email" type="email" class="form-control form-modern" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- UNIVERSITE -->
                        <div class="mb-3">
                            <label asp-for="University" class="form-label">
                                <i class="fas fa-university text-gold me-1"></i> Université
                            </label>
                            <input asp-for="University" class="form-control form-modern" placeholder="Optionnel" />
                        </div>

                        <!-- TELEPHONE -->
                        <div class="mb-4">
                            <label asp-for="PhoneNumber" class="form-label">
                                <i class="fas fa-phone text-gold me-1"></i> Téléphone
                            </label>
                            <input asp-for="PhoneNumber" class="form-control form-modern" placeholder="12345678" />
                            <small class="text-muted">Optionnel</small>
                        </div>

                        <!-- BUTTONS -->
                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-modern flex-grow-1">
                                <i class="fas fa-save me-2"></i> Enregistrer
                            </button>

                            <a asp-action="Profile" class="btn btn-outline-modern flex-grow-1 text-center">
                                <i class="fas fa-times me-2"></i> Annuler
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}