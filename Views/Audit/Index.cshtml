@model IEnumerable<CovStudent.Models.AuditLog>
@{
    ViewData["Title"] = "Journal d'audit";
    int numPage = ViewBag.Page;
    int totalPages = ViewBag.TotalPages;
    var types = (List<string>)ViewBag.Types;
}

<h1 class="h3 mb-3">Journal d'audit</h1>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-3">
        <label for="type" class="form-label">Action</label>
        <select id="type" name="type" class="form-select">
            <option value="">Toutes</option>
            @foreach (var t in types)
            {
                <option value="@t" selected="@(t == (string?)ViewBag.Type)">@t</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label for="utilisateur" class="form-label">Utilisateur</label>
        <input id="utilisateur" name="utilisateur" value="@ViewBag.Utilisateur" class="form-control" placeholder="email" />
    </div>
    <div class="col-md-2">
        <label for="du" class="form-label">Du</label>
        <input id="du" name="du" type="date" value="@ViewBag.Du" class="form-control" />
    </div>
    <div class="col-md-2">
        <label for="au" class="form-label">Au</label>
        <input id="au" name="au" type="date" value="@ViewBag.Au" class="form-control" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Filtrer</button>
    </div>
</form>

<p class="text-muted">@ViewBag.Total entrée(s)</p>

@if (!Model.Any())
{
    <div class="alert alert-info">Aucune entrée pour ces critères.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-striped align-middle">
            <caption class="visually-hidden">Actions enregistrées dans le journal d'audit</caption>
            <thead>
                <tr>
                    <th scope="col">Date</th>
                    <th scope="col">Utilisateur</th>
                    <th scope="col">Action</th>
                    <th scope="col">Entité</th>
                    <th scope="col">Détails</th>
                    <th scope="col">IP</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td>@log.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td>@(log.UserName ?? "—")</td>
                        <td><span class="badge bg-secondary">@log.Action</span></td>
                        <td>@log.Entity @(log.EntityId != null ? "#" + log.EntityId : "")</td>
                        <td>@log.Details</td>
                        <td>@log.IpAddress</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav aria-label="Pagination du journal">
        <ul class="pagination">
            <li class="page-item @(numPage <= 1 ? "disabled" : "")">
                <a class="page-link" asp-route-page="@(numPage - 1)" asp-route-type="@ViewBag.Type"
                   asp-route-utilisateur="@ViewBag.Utilisateur" asp-route-du="@ViewBag.Du" asp-route-au="@ViewBag.Au">Précédent</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Page @(numPage) / @(totalPages)</span>
            </li>
            <li class="page-item @(numPage >= totalPages ? "disabled" : "")">
                <a class="page-link" asp-route-page="@(numPage + 1)" asp-route-type="@ViewBag.Type"
                   asp-route-utilisateur="@ViewBag.Utilisateur" asp-route-du="@ViewBag.Du" asp-route-au="@ViewBag.Au">Suivant</a>
            </li>
        </ul>
    </nav>
}