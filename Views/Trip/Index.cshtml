@model IEnumerable<CovStudent.Models.Trip>

@{
    ViewData["Title"] = "Liste des trajets";
}

<h1>🚗 Trajets disponibles</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Publier un trajet</a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Départ</th>
            <th>Destination</th>
            <th>Date et heure</th>
            <th>Places</th>
            <th>Prix</th>
            <th>Conducteur</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Departure</td>
                <td>@item.Destination</td>
                <td>@item.DepartureTime.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.AvailableSeats</td>
                <td>@item.PricePerSeat TND</td>
                <td>@(item.Driver?.FullName ?? "À définir")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Détails</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Modifier</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Supprimer</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Aucun trajet disponible pour le moment. <a asp-action="Create">Soyez le premier à publier un trajet !</a>
    </div>
}