@using CovStudent.Models
@model Trip

@{
    ViewData["Title"] = "Publier un trajet";
}

<div class="page-shell trip-create-shell">
    <section class="page-hero page-hero-dark trip-create-hero">
        <div>
            <span class="eyebrow"><i class="fas fa-car-side"></i> Conducteur</span>
            <h1 class="page-title">Publier un trajet</h1>
            <p class="hero-subtitle">Une annonce claire, bien structurée et visuellement rassurante attire plus facilement les réservations.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-light">
            <i class="fas fa-arrow-left me-2"></i>Retour
        </a>
    </section>

    <div class="trip-create-layout">
        <section class="form-card">
            <div class="form-card-header">
                <div class="trip-form-header-copy">
                    <span class="eyebrow"><i class="fas fa-route"></i>Annonce de trajet</span>
                    <h1>Préparez les détails essentiels</h1>
                    <p>Les informations les plus utiles doivent être visibles en premier pour aider les passagers à réserver rapidement.</p>
                    <div class="trip-form-tags">
                        <span class="dashboard-tag"><i class="fas fa-route"></i>Visible sur la carte</span>
                        <span class="dashboard-tag"><i class="fas fa-shield-heart"></i>Plus rassurant</span>
                        <span class="dashboard-tag"><i class="fas fa-bolt"></i>Publication rapide</span>
                    </div>
                </div>
                <div class="trip-form-badge">
                    <i class="fas fa-paper-plane"></i>
                    <span>Annonce publique</span>
                </div>
            </div>

            <div class="form-card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-4"></div>

                    <div class="route-summary mb-4">
                        <div>
                            <small>Conseil</small>
                            <strong>Choisissez un point de rendez-vous simple à trouver.</strong>
                        </div>
                        <div>
                            <small>Astuce</small>
                            <strong>Une description courte et concrète améliore les réservations.</strong>
                        </div>
                    </div>

                    <section class="form-section">
                        <div class="form-section-title">
                            <i class="fas fa-map-location-dot"></i> Itinéraire
                        </div>
                        <div class="form-grid-2">
                            <div>
                                <label asp-for="Departure" class="form-label">Ville de départ</label>
                                <input asp-for="Departure" class="form-control form-control-lg" placeholder="Ex: Tunis" />
                                <small class="field-hint">Indiquez la ville ou le point de départ exact.</small>
                                <span asp-validation-for="Departure" class="text-danger small"></span>
                            </div>

                            <div>
                                <label asp-for="Destination" class="form-label">Destination</label>
                                <input asp-for="Destination" class="form-control form-control-lg" placeholder="Ex: Sousse" />
                                <small class="field-hint">La destination principale du trajet.</small>
                                <span asp-validation-for="Destination" class="text-danger small"></span>
                            </div>
                        </div>
                    </section>

                    <section class="form-section">
                        <div class="form-section-title">
                            <i class="fas fa-calendar"></i> Horaires
                        </div>
                        <div class="form-grid-2">
                            <div>
                                <label asp-for="DepartureTime" class="form-label">Date et heure de départ</label>
                                <input asp-for="DepartureTime" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" step="60" class="form-control form-control-lg" />
                                <small class="field-hint">Les passagers veulent voir l’horaire dès le premier coup d’œil.</small>
                                <span asp-validation-for="DepartureTime" class="text-danger small"></span>
                            </div>

                            <div>
                                <label asp-for="ArrivalTime" class="form-label">Arrivée estimée</label>
                                <input asp-for="ArrivalTime" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" step="60" class="form-control form-control-lg" />
                                <small class="field-hint">Option utile pour anticiper l’organisation du voyage.</small>
                                <span asp-validation-for="ArrivalTime" class="text-danger small"></span>
                            </div>
                        </div>
                    </section>

                    <section class="form-section">
                        <div class="form-section-title">
                            <i class="fas fa-coins"></i> Places et prix
                        </div>
                        <div class="form-grid-2">
                            <div>
                                <label asp-for="AvailableSeats" class="form-label">Places disponibles</label>
                                <input asp-for="AvailableSeats" type="number" min="1" max="8" class="form-control form-control-lg" placeholder="4" />
                                <small class="field-hint">Gardez une capacité réaliste par rapport au véhicule.</small>
                                <span asp-validation-for="AvailableSeats" class="text-danger small"></span>
                            </div>

                            <div>
                                <label asp-for="PricePerSeat" class="form-label">Prix par place (TND)</label>
                                <input asp-for="PricePerSeat" type="number" step="0.5" min="0" class="form-control form-control-lg" placeholder="10.00" />
                                <small class="field-hint">Un prix clair évite les questions avant la réservation.</small>
                                <span asp-validation-for="PricePerSeat" class="text-danger small"></span>
                            </div>
                        </div>
                    </section>

                    <section class="form-section">
                        <div class="form-section-title">
                            <i class="fas fa-location-dot"></i> Informations passager
                        </div>
                        <div class="mb-3">
                            <label asp-for="MeetingPoint" class="form-label">Point de rendez-vous</label>
                            <input asp-for="MeetingPoint" class="form-control" placeholder="Ex: devant l'entrée principale" />
                            <small class="field-hint">Facilite la rencontre et réduit les échanges inutiles.</small>
                            <span asp-validation-for="MeetingPoint" class="text-danger small"></span>
                        </div>

                        <div>
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" rows="4" class="form-control" placeholder="Bagages, flexibilité, consignes particulières..."></textarea>
                            <small class="field-hint">Ajoutez les détails qui rassurent vraiment les passagers.</small>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </section>

                    <div class="trip-form-footer-note mb-4">
                        <i class="fas fa-circle-info"></i>
                        Le trajet sera publié immédiatement après validation et apparaîtra dans la carte des trajets actifs.
                    </div>

                    <div class="form-actions">
                        <a asp-action="Index" class="btn btn-outline-dark">
                            <i class="fas fa-times me-2"></i>Annuler
                        </a>
                        <button type="submit" class="btn btn-dark">
                            <i class="fas fa-paper-plane me-2"></i>Publier mon trajet
                        </button>
                    </div>
                </form>
            </div>
        </section>

        <aside class="trip-create-sidebar surface-card">
            <div class="trip-sidebar-panel">
                <span class="eyebrow"><i class="fas fa-wand-magic-sparkles"></i> Aperçu</span>
                <h2>Ce que les passagers vont retenir</h2>
                <p>Une présentation claire renforce la confiance et améliore la lisibilité de votre annonce.</p>
            </div>

            <div class="trip-sidebar-list">
                <div class="trip-sidebar-item">
                    <div class="trip-sidebar-icon"><i class="fas fa-map-pin"></i></div>
                    <div>
                        <strong>Un itinéraire précis</strong>
                        <span>Départ, destination et point de rendez-vous faciles à comprendre.</span>
                    </div>
                </div>
                <div class="trip-sidebar-item">
                    <div class="trip-sidebar-icon"><i class="fas fa-clock"></i></div>
                    <div>
                        <strong>Des horaires visibles</strong>
                        <span>L’heure de départ et l’arrivée estimée sont mises en avant.</span>
                    </div>
                </div>
                <div class="trip-sidebar-item">
                    <div class="trip-sidebar-icon"><i class="fas fa-coins"></i></div>
                    <div>
                        <strong>Un prix lisible</strong>
                        <span>Le tarif est clair, sans ambiguïté pour les passagers.</span>
                    </div>
                </div>
            </div>

            <div class="trip-sidebar-checklist">
                <h3>Checklist rapide</h3>
                <ul>
                    <li><i class="fas fa-check"></i>Ville de départ et destination renseignées</li>
                    <li><i class="fas fa-check"></i>Point de rendez-vous simple</li>
                    <li><i class="fas fa-check"></i>Prix et places cohérents</li>
                    <li><i class="fas fa-check"></i>Description utile et concise</li>
                </ul>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
