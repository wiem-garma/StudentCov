@model CovStudent.Models.Trip

@{
    ViewData["Title"] = "Modifier le trajet";
}

<style>
    .edit-container {
        background: linear-gradient(135deg, rgba(19,111,99,0.05), rgba(107,94,168,0.05));
        padding: 40px 0;
        min-height: 100vh;
    }

    .edit-card {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 35px rgba(0,0,0,0.08);
    }

    .edit-header {
        background: linear-gradient(135deg, #136f63, #0d5148);
        color: white;
        padding: 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }

    .edit-header-content {
        flex: 1;
        min-width: 250px;
    }

    .edit-eyebrow {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
        opacity: 0.85;
        margin-bottom: 8px;
    }

    .edit-title {
        font-size: 24px;
        font-weight: 700;
        margin: 0;
    }

    .edit-body {
        padding: 30px;
    }

    .form-section {
        margin-bottom: 30px;
    }

    .form-section:last-child {
        margin-bottom: 0;
    }

    .form-section-title {
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 700;
        color: #136f63;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .form-section-title i {
        color: #d99a2b;
    }

    .form-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-label {
        font-weight: 600;
        color: #202124;
        margin-bottom: 8px;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .form-label i {
        color: #d99a2b;
        font-size: 12px;
    }

    .form-control {
        border-radius: 10px;
        border: 1.5px solid #e5e5e5;
        padding: 10px 14px;
        font-size: 14px;
        transition: 0.2s ease;
    }

    .form-control:focus {
        border-color: #136f63;
        box-shadow: 0 0 0 3px rgba(19,111,99,0.1);
        outline: none;
    }

    .form-control.form-control-lg {
        padding: 12px 16px;
        font-size: 15px;
    }

    textarea.form-control {
        resize: vertical;
        min-height: 100px;
        font-family: inherit;
    }

    .validation-error {
        color: #b9473c;
        font-size: 12px;
        margin-top: 6px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .validation-error i {
        font-size: 11px;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #e5e5e5;
    }

    .form-actions .btn {
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        transition: 0.2s ease;
    }

    .form-actions .btn-outline-dark:hover {
        background: #f8f9fa;
    }

    .form-actions .btn-dark:hover {
        background: #0d5148;
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(13,81,72,0.2);
    }

    .validation-summary {
        background: linear-gradient(135deg, rgba(185,71,60,0.08), rgba(226,167,46,0.08));
        border-left: 4px solid #b9473c;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
    }

    .validation-summary ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .validation-summary li {
        color: #b9473c;
        font-weight: 600;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .validation-summary li i {
        font-size: 12px;
    }
</style>

<div class="edit-container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="edit-card">
                <div class="edit-header">
                    <div class="edit-header-content">
                        <div class="edit-eyebrow"><i class="fas fa-edit me-1"></i>Gestion conducteur</div>
                        <h1 class="edit-title">Modifier le trajet</h1>
                    </div>
                    <a asp-controller="Dashboard" asp-action="MyTrips" class="btn btn-outline-light">
                        <i class="fas fa-arrow-left me-2"></i>Retour
                    </a>
                </div>

                <div class="edit-body">
                    <form asp-action="Edit" method="post" class="app-form">
                        <input type="hidden" asp-for="Id" />
                        
                        @if (ViewData.ModelState[""]?.Errors.Count > 0)
                        {
                            <div class="validation-summary" asp-validation-summary="All">
                                <ul>
                                    @foreach (var modelState in ViewData.ModelState.Values)
                                    {
                                        @foreach (var error in modelState.Errors)
                                        {
                                            <li><i class="fas fa-times-circle"></i>@error.ErrorMessage</li>
                                        }
                                    }
                                </ul>
                            </div>
                        }

                        <!-- SECTION 1: ROUTE -->
                        <div class="form-section">
                            <div class="form-section-title">
                                <i class="fas fa-map-location-dot"></i>Itinéraire
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label asp-for="Departure" class="form-label">
                                        <i class="fas fa-play-circle"></i>Départ
                                    </label>
                                    <input asp-for="Departure" class="form-control form-control-lg" placeholder="Ville de départ" />
                                        <div class="validation-error"><i class="fas fa-exclamation-circle"></i><span asp-validation-for="Departure"></span></div>
                                </div>
                                <div class="form-group">
                                    <label asp-for="Destination" class="form-label">
                                        <i class="fas fa-location-crosshairs"></i>Destination
                                    </label>
                                    <input asp-for="Destination" class="form-control form-control-lg" placeholder="Ville d'arrivée" />
                                        <div class="validation-error"><i class="fas fa-exclamation-circle"></i><span asp-validation-for="Destination"></span></div>
                                </div>
                            </div>
                        </div>

                        <!-- SECTION 2: DATE & HEURE -->
                        <div class="form-section">
                            <div class="form-section-title">
                                <i class="fas fa-calendar"></i>Date et heure
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label asp-for="DepartureTime" class="form-label">
                                        <i class="fas fa-arrow-right"></i>Départ
                                    </label>
                                    <input asp-for="DepartureTime" type="datetime-local" class="form-control form-control-lg" />
                                    <div class="validation-error"><i class="fas fa-exclamation-circle"></i><span asp-validation-for="DepartureTime"></span></div>
                                </div>
                                <div class="form-group">
                                    <label asp-for="ArrivalTime" class="form-label">
                                        <i class="fas fa-arrow-left"></i>Arrivée estimée
                                    </label>
                                    <input asp-for="ArrivalTime" type="datetime-local" class="form-control form-control-lg" />
                                    <div class="validation-error"><i class="fas fa-exclamation-circle"></i><span asp-validation-for="ArrivalTime"></span></div>
                                </div>
                            </div>
                        </div>

                        <!-- SECTION 3: PLACES & PRIX -->
                        <div class="form-section">
                            <div class="form-section-title">
                                <i class="fas fa-coins"></i>Places et tarification
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label asp-for="AvailableSeats" class="form-label">
                                        <i class="fas fa-chair"></i>Places disponibles
                                    </label>
                                    <input asp-for="AvailableSeats" type="number" min="1" max="8" class="form-control form-control-lg" />
                                    <div class="validation-error"><i class="fas fa-exclamation-circle"></i><span asp-validation-for="AvailableSeats"></span></div>
                                </div>
                                <div class="form-group">
                                    <label asp-for="PricePerSeat" class="form-label">
                                        <i class="fas fa-tag"></i>Prix par place (TND)
                                    </label>
                                    <input asp-for="PricePerSeat" type="number" step="0.5" min="0" class="form-control form-control-lg" />
                                    <div class="validation-error"><i class="fas fa-exclamation-circle"></i><span asp-validation-for="PricePerSeat"></span></div>
                                </div>
                            </div>
                        </div>

                        <!-- SECTION 4: RENDEZ-VOUS -->
                        <div class="form-section">
                            <div class="form-section-title">
                                <i class="fas fa-location-dot"></i>Point de rendez-vous
                            </div>
                            <div class="form-group">
                                <label asp-for="MeetingPoint" class="form-label">
                                    <i class="fas fa-compass"></i>Localisation
                                </label>
                                <input asp-for="MeetingPoint" class="form-control" placeholder="Ex: devant l'entrée principale" />
                                <div class="validation-error"><i class="fas fa-exclamation-circle"></i><span asp-validation-for="MeetingPoint"></span></div>
                                <small style="color: #68706a; margin-top: 6px; display: block;">
                                    Indiquez le lieu exact du point de rendez-vous pour les passagers.
                                </small>
                            </div>
                        </div>

                        <!-- SECTION 5: DESCRIPTION -->
                        <div class="form-section">
                            <div class="form-section-title">
                                <i class="fas fa-file-lines"></i>Description additionnelle
                            </div>
                            <div class="form-group">
                                <label asp-for="Description" class="form-label">
                                    <i class="fas fa-pencil"></i>Notes importantes
                                </label>
                                <textarea asp-for="Description" rows="4" class="form-control" placeholder="Ex: bagages, horaire flexible, conditions de trajet..."></textarea>
                                <div class="validation-error"><i class="fas fa-exclamation-circle"></i><span asp-validation-for="Description"></span></div>
                                <small style="color: #68706a; margin-top: 6px; display: block;">
                                    Ajoutez des informations utiles pour les passagers (500 caractères max).
                                </small>
                            </div>
                        </div>

                        <!-- ACTIONS -->
                        <div class="form-actions">
                            <a asp-controller="Dashboard" asp-action="MyTrips" class="btn btn-outline-dark">
                                <i class="fas fa-times me-2"></i>Annuler
                            </a>
                            <button type="submit" class="btn btn-dark">
                                <i class="fas fa-save me-2"></i>Enregistrer les modifications
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
